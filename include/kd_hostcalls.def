/*
 * Shared JIT hostcall manifest.
 *
 * Define KD_HOSTCALL(name, id, symbol, flags) before including this file.
 * Keep IDs stable: generated artifacts and the kernel dispatcher use the same
 * declaration, although runtime dispatch still validates the resolved address.
 */
KD_HOSTCALL(KTIME_GET, 1, ktime_get,
	KD_HOSTCALL_F_ATOMIC_SAFE | KD_HOSTCALL_F_NO_TASK_CONTEXT |
	KD_HOSTCALL_F_RETRY_SAFE)
KD_HOSTCALL(KTIME_GET_NS, 2, ktime_get_ns,
	KD_HOSTCALL_F_ATOMIC_SAFE | KD_HOSTCALL_F_NO_TASK_CONTEXT |
	KD_HOSTCALL_F_RETRY_SAFE)
KD_HOSTCALL(INT_SQRT, 3, int_sqrt,
	KD_HOSTCALL_F_ATOMIC_SAFE | KD_HOSTCALL_F_NO_TASK_CONTEXT |
	KD_HOSTCALL_F_RETRY_SAFE)
