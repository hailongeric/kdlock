--- a/module.c
+++ b/module.c
@@ -52,6 +52,8 @@
 	struct sc_run run;
 	void (*body)(void);
 	__u64 post_state = 1;
+	unsigned int before_preempt;
+	bool before_irqs;
 	int i;
 
 	(void)file;
@@ -81,6 +83,8 @@
 		}
 		if (!sc_run_enter())
 			return -EBUSY;
+		before_preempt = preempt_count();
+		before_irqs = irqs_disabled();
 		/* One ioctl owns this full batch. A small register dependency chain
