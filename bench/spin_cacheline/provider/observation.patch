diff --git a/include/utils.h b/include/utils.h
--- a/include/utils.h
+++ b/include/utils.h
@@ -4,18 +4,31 @@
 /* Existing diagnostics shared by runtime modules. Log prefixes and source
  * locations aid inspection; they are observations, not execution or ACK proof. */
 #include <linux/kernel.h>
+#include "kd_bench.h"
 
 #define CONFIG_KD_DEBUG 1
 
 #ifdef CONFIG_KD_DEBUG
-#define KD_PR_DEBUG(fmt, ...)                               \
+#define KD_PR_DEBUG_ALWAYS(fmt, ...)                        \
 	pr_info("[KD][%s:%d][%s] " fmt, __FILE__, __LINE__, \
 		__func__, ##__VA_ARGS__)
 #else
-#define KD_PR_DEBUG(fmt, ...) \
+#define KD_PR_DEBUG_ALWAYS(fmt, ...) \
 	do {                  \
 	} while (0)
 #endif
+
+#define KD_PR_DEBUG(fmt, ...)                         \
+	do {                                          \
+		if (!kd_bench_quiet)                   \
+			KD_PR_DEBUG_ALWAYS(fmt, ##__VA_ARGS__); \
+	} while (0)
+
+#define KD_PR_ROUTINE(fmt, ...)                  \
+	do {                                     \
+		if (!kd_bench_quiet)              \
+			pr_info(fmt, ##__VA_ARGS__); \
+	} while (0)
 
 #define KD_PR_INFO(fmt, ...) pr_info(fmt, ##__VA_ARGS__)
 
@@ -23,13 +36,19 @@
 
 #define DSM_DEBUG 1
 #ifdef DSM_DEBUG
-#define print_debug(fmt, ...)                                              \
+#define print_debug_always(fmt, ...)                                       \
 	({                                                                 \
 		printk(KERN_INFO "[%d] kdlock (%s) lock(%px): " fmt,       \
 		       smp_processor_id(), __func__, lock, ##__VA_ARGS__); \
 	})
 #else
-#define print_debug(fmt, ...)
+#define print_debug_always(fmt, ...)
 #endif
 
+#define print_debug(fmt, ...)                          \
+	do {                                           \
+		if (!kd_bench_quiet)                    \
+			print_debug_always(fmt, ##__VA_ARGS__); \
+	} while (0)
+
 #endif /* UTILS_H */
