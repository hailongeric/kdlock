+ * native error cleanup. Ordinary callers never arm it. No callback executes. */
+static int kd_mmap_unmap_test_error(struct mm_struct *mm, unsigned long start,
+		unsigned long end, unsigned int splits, bool native)
+{
+#ifdef CONFIG_KD_MMAP_LOCK
+	struct kd_mmap_unmap_state *u = &mm->mmap_lock.unmap;
+
+	if (u->test_fail_after == splits && start >= u->start && end <= u->end) {
+		BUG_ON(!splits || !kd_mmap_is_write_owner(&mm->mmap_lock));
+		u->test_fail_after = 0;
+		u->test_fail_seen++;
+		pr_info("KD_MM_SPLIT inject mm=%px executor=%d start=%lx end=%lx splits=%u native=%u result=%d\n",
+			mm, current->pid, start, end, splits, native, -ENOMEM);
+		return -ENOMEM;
+	}
+#endif
+	return 0;
+}
