 	atomic_long_set(&sem->readers, 0);
 	atomic_long_set(&sem->admission, 0);
-	init_waitqueue_head(&sem->drain);
+	init_waitqueue_head(&sem->phase_wait);
+	init_waitqueue_head(&sem->reader_drain);
 }
