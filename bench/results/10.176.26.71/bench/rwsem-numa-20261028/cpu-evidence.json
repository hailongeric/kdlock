{
  "caveat": "worker.cpu_ns is time.thread_time_ns() sampled in the Python client around the complete workload ioctl, while active timestamps cover the in-kernel operation loop. CPU time therefore includes small ioctl entry/exit and client accounting overhead outside the active interval; slight ratios above one are retained without clamping. This is an interval comparison, not a park count, scheduler trace, wait-site attribution, strict bound on off-CPU time, or PMU measurement. Single-round exploratory timings have no repeat-variability estimate. The 32-to-36 comparison also changes worker count; a fixed-count placement control is needed to isolate NUMA crossing.",
  "formulas": {
    "aggregate_cpu_ns_per_op": "sum_cpu_ns / completed",
    "busy_fraction": "sum_cpu_ns / total_active_ns",
    "sum_cpu_ns": "sum(worker.cpu_ns)",
    "total_active_ns": "sum(worker.kernel_finished_ns - worker.active_started_ns)",
    "whole_mops_s": "completed * 1e3 / wall_ns"
  },
  "interpretation": "Near-unity CPU/active-time ratios support busy-execution, spinning or coherence costs rather than substantial off-CPU waiting as the dominant throughput loss in these observations. These receipts do not distinguish CPU instructions from spin or coherence stalls.",
  "measurement": {
    "backends": [
      "kdlock",
      "tclock"
    ],
    "duration_ms": 2000,
    "post_work_rounds": 256,
    "repetitions_per_point": 1,
    "worker_placement": "CPU prefixes 0..N-1; collector CPU63; node0 CPUs0..31, node1 CPUs32..63",
    "workers": [
      16,
      32,
      36,
      60
    ]
  },
