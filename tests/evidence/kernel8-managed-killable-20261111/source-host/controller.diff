+def verify_exact_frontier_archive(value, bounds):
+    """Join distinct reservations to the durable archive and actual SETTLE bytes."""
+    def read(path, limit):
+        need(path.is_file() and not path.is_symlink() and 0 < path.stat().st_size <= limit,
+             'missing or oversized exact record: ' + str(path))
+        data=path.read_bytes();need(len(data)<=limit,'record exceeded its read bound')
+        return data
+
+    def identity(value):
+        need(type(value) is str and len(value)==16 and value==bytes.fromhex(value).hex()
+             and any(bytes.fromhex(value)), 'exact nonzero eight-byte identity required')
+        return value
+
+    def plain_identity(value):
+        need(type(value) is dict and set(value)=={'bytes_hex'}, 'archive bytes schema differs')
+        return identity(value['bytes_hex'])
+
+    def key(row):
+        need(type(row['incarnation']) is int and row['incarnation']>0, 'exact incarnation required')
+        return identity(row['epoch']),identity(row['record']),row['incarnation']
+
+    def key_set(rows):
+        need(type(rows) is list and len(rows)<=bounds['claim_capacity'], 'finite exact key list required')
+        values=[key(row) for row in rows]
+        need(len(values)==len(set(values)), 'distinct exact reservations were duplicated')
+        return set(values)
+
+    def archive_key(row):
+        need(row['type']=='disassem.learning.FactKey', 'archive FactKey schema differs')
+        fields=row['fields']
+        return key({'epoch':plain_identity(fields['epoch_identity']),
+                    'record':plain_identity(fields['record_identity']),'incarnation':fields['incarnation']})
+
