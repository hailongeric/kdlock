config KD_API_LOCKS
	bool "Scoped KD binding for file tables and pipes"
	depends on X86_64 && SMP && FRAME_POINTER && MODULES
	depends on !PREEMPT_RT && !DEBUG_MUTEXES && !DEBUG_SPINLOCK
	depends on !DEBUG_LOCK_ALLOC && !LOCKDEP
	default n
	help
	  Preserve native syscall bodies while binding selected newly created
	  file tables/pipes to one loadable KD provider. All object participants
	  share that immutable backend. This is an experimental scoped interface,
	  not a global lock replacement. Native creation remains the default.
