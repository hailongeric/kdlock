+#ifdef CONFIG_KD_MMAP_LOCK
+int kd_mmap_mas_preallocate(struct ma_state *mas, gfp_t gfp)
+{
+	/* Preparation never walks/dereferences a live tree node. Read only a
+	 * scalar height hint, allocate on the originating task, then require
+	 * sufficient actual capacity again under mmap write ownership. */
+	unsigned int height = (READ_ONCE(mas->tree->ma_flags) & MT_FLAGS_HEIGHT_MASK) >>
+			      MT_FLAGS_HEIGHT_OFFSET;
+
+	return mas_preallocate_height(mas, height, gfp);
