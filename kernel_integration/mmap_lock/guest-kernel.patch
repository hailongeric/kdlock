+/* The owner transfers one already acquired read share; this function does not
+ * acquire another share and must precede publication to the completion queue. */
+void mmap_read_unlock_prepare(struct mmap_read_token *token, struct mm_struct *mm)
+{
+	BUG_ON(!mm || READ_ONCE(token->mm));
+	mmgrab(mm);
+	WRITE_ONCE(token->mm, mm);
+#ifndef CONFIG_KD_MMAP_LOCK
+	/* KD integration is restricted to non-lockdep configurations. */
+	rwsem_release(&mm->mmap_lock.dep_map, _RET_IP_);
+#endif
+}
+EXPORT_SYMBOL_GPL(mmap_read_unlock_prepare);
+
+void mmap_read_unlock_complete(struct mmap_read_token *token)
+{
+	struct mm_struct *mm = xchg(&token->mm, NULL);
+
+	/* A duplicate completion cannot consume somebody else's read share. */
+	BUG_ON(!mm);
+	mmap_read_unlock_non_owner(mm);
+	/* __mmdrop/pgd_dtor cannot run in hardirq or softirq context on x86. */
+	mmdrop_async(mm);
+}
+EXPORT_SYMBOL_GPL(mmap_read_unlock_complete);
