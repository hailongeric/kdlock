diff --git a/include/linux/kd_spin_hooks.h b/include/linux/kd_spin_hooks.h
new file mode 100644
--- /dev/null
+++ b/include/linux/kd_spin_hooks.h
@@ -0,0 +1,41 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _LINUX_KD_SPIN_HOOKS_H
+#define _LINUX_KD_SPIN_HOOKS_H
+
+#include <linux/spinlock_types.h>
+
+/* A real, opt-in native caller-clobber ABI. Ordinary Linux spin macros and
+ * object protocols are unchanged; this header installs no delegation hooks.
+ */
+#if defined(CONFIG_X86_64) && defined(CONFIG_SMP) && \
+	defined(CONFIG_FRAME_POINTER) && !defined(CONFIG_PREEMPT_RT)
+#include <asm/asm.h>
+#define KD_SPIN_CLOBBER_V1 1
+
+void kd_raw_spin_lock_clobber_v1(raw_spinlock_t *lock, unsigned long sp,
+				unsigned long ip, unsigned long bp);
+void kd_raw_spin_unlock_clobber_v1(raw_spinlock_t *lock, unsigned long sp,
+				  unsigned long ip, unsigned long bp);
+
+/* The compiler spills live values across this explicit boundary. RDI names a
+ * Linux raw spinlock; RSI/RDX/RCX carry pre-CALL SP/continuation/BP. Preserve
+ * RSP/RBP and declare every other GPR, flags and memory clobbered. KD objects
+ * use their own same-ABI module entries and must never enter these bridges.
+ */
+#define __kd_spin_clobber_call_v1(symbol, lock) do {                      \
+	raw_spinlock_t *kd_lock_arg = (lock);                             \
+	unsigned long kd_sp_out, kd_ip_out, kd_bp_out;                    \
+	asm volatile("movq %%rsp, %%rsi\n\t"                              \
+		     "leaq 1f(%%rip), %%rdx\n\t"                         \
+		     "movq %%rbp, %%rcx\n\t"                             \
+		     "call " #symbol "\n\t1:\n\t"                       \
+		     : "+D" (kd_lock_arg), "=S" (kd_sp_out),              \
+		       "=d" (kd_ip_out), "=c" (kd_bp_out),                \
+		       ASM_CALL_CONSTRAINT                              \
+		     :                                                   \
+		     : "rax", "rbx", "r8", "r9", "r10", "r11",        \
+		       "r12", "r13", "r14", "r15", "cc", "memory");     \
+} while (0)
+#endif
+
+#endif /* _LINUX_KD_SPIN_HOOKS_H */
