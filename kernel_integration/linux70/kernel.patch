+#ifdef KD_SPIN_CLOBBER_V1
+/* Explicit ABI callers supply their pre-CALL SP, continuation and BP. Native
+ * execution needs only the lock; metadata remains part of the versioned ABI.
+ * There is no selector, callback installation or global spin macro routing.
+ * The native helpers preserve paired preemption and the caller's IRQ state.
+ */
+noinline notrace void kd_raw_spin_lock_clobber_v1(raw_spinlock_t *lock,
+		unsigned long sp, unsigned long ip, unsigned long bp)
+{
+	(void)sp;
+	(void)ip;
+	(void)bp;
+	__raw_spin_lock(lock);
+}
+EXPORT_SYMBOL_GPL(kd_raw_spin_lock_clobber_v1);
+
+noinline notrace void kd_raw_spin_unlock_clobber_v1(raw_spinlock_t *lock,
+		unsigned long sp, unsigned long ip, unsigned long bp)
+{
+	(void)sp;
+	(void)ip;
+	(void)bp;
+	__raw_spin_unlock(lock);
+}
+EXPORT_SYMBOL_GPL(kd_raw_spin_unlock_clobber_v1);
+#endif
