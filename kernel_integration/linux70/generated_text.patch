 #include <asm/text-patching.h>
 #include <asm/insn.h>
@@ -118,6 +119,10 @@
 static void *its_page;
 static unsigned int its_offset;
 struct its_array its_pages;
+/* Core construction ends at its_fini_core; this descriptor owns the retained
+ * vector thereafter. Neither the vector nor its entries change after publish. */
+static struct its_array kd_core_its __ro_after_init;
+static bool kd_core_its_ready __ro_after_init;
 
 static void *__its_alloc(struct its_array *pages)
 {
@@ -182,7 +187,12 @@
 {
 	if (IS_ENABLED(CONFIG_STRICT_KERNEL_RWX))
 		its_pages_protect(&its_pages);
-	kfree(its_pages.pages);
+	/* The pages already remain resident. Retain their producer inventory too,
+	 * rather than inferring membership from address ranges or text contents. */
+	kd_core_its = its_pages;
+	its_pages.pages = NULL;
+	its_pages.num = 0;
+	smp_store_release(&kd_core_its_ready, true);
 }
 
 #ifdef CONFIG_MODULES
@@ -298,6 +308,55 @@
 #else
 static inline void its_fini_core(void) {}
 #endif /* CONFIG_MITIGATION_ITS */
+
+#if defined(CONFIG_MITIGATION_ITS) && defined(CONFIG_MODULES)
+/* Internal cross-unit helper; remaining carries the same query work budget. */
+int kd_generated_module_text_lookup(unsigned long address,
+				    struct kd_generated_text_extent *extent,
+				    unsigned int remaining);
+#endif
+
+/* One unit per core page, module node or module page. This limit applies to
+ * the whole query, including the module helper, under the raw source guard. */
+#define KD_GENERATED_TEXT_SCAN_UNITS 4096U
+
+int kd_generated_text_lookup(unsigned long address,
+			     struct kd_generated_text_extent *extent)
+{
+#ifdef CONFIG_MITIGATION_ITS
+	unsigned int remaining = KD_GENERATED_TEXT_SCAN_UNITS;
+#endif
+
+	if (!extent)
+		return -EINVAL;
+#ifdef CONFIG_MITIGATION_ITS
+	if (smp_load_acquire(&kd_core_its_ready)) {
+		for (int i = 0; i < kd_core_its.num; i++) {
+			unsigned long start;
+
+			if (!remaining)
+				return -ENOSPC;
+			remaining--;
+			start = (unsigned long)kd_core_its.pages[i];
+			if (!start || !IS_ALIGNED(start, PAGE_SIZE) ||
+			    start > ULONG_MAX - PAGE_SIZE ||
+			    address < start || address - start >= PAGE_SIZE)
+				continue;
+			*extent = (struct kd_generated_text_extent) {
+				.start = start, .end = start + PAGE_SIZE,
+				.owner = NULL, .abi = KD_GENERATED_TEXT_ABI_VERSION,
+				.kind = KD_GENERATED_TEXT_CORE_ITS,
+			};
+			return 0;
+		}
+	}
+#ifdef CONFIG_MODULES
+	return kd_generated_module_text_lookup(address, extent, remaining);
+#endif
+#endif
+	return -ENOENT;
+}
+EXPORT_SYMBOL_GPL(kd_generated_text_lookup);
 
