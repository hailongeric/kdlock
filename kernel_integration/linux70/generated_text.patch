--- a/kernel/module/main.c
+++ b/kernel/module/main.c
@@ -59,6 +59,7 @@
 #include <linux/codetag.h>
 #include <linux/debugfs.h>
 #include <linux/execmem.h>
+#include <linux/kd_generated_text.h>
 #include <uapi/linux/module.h>
 #include "internal.h"
 
@@ -74,6 +75,66 @@
  */
 DEFINE_MUTEX(module_mutex);
 LIST_HEAD(modules);
+
+#if defined(CONFIG_X86) && defined(CONFIG_MITIGATION_ITS)
+/* Internal counterpart of the static-core query in alternative.c. */
+int kd_generated_module_text_lookup(unsigned long address,
+				    struct kd_generated_text_extent *extent,
+				    unsigned int remaining);
+
+int kd_generated_module_text_lookup(unsigned long address,
+				    struct kd_generated_text_extent *extent,
+				    unsigned int remaining)
+{
+	struct module *mod;
+
+	rcu_read_lock();
+	list_for_each_entry_rcu(mod, &modules, list) {
+		if (!remaining)
+			goto exhausted;
+		remaining--;
+		/* RCU retains mod, but not its architecture allocations during
+		 * teardown. Take the live reference before reading that inventory.
+		 * LIVE publication follows completion of the ITS page vector. */
+		if (smp_load_acquire(&mod->state) != MODULE_STATE_LIVE ||
+		    !try_module_get(mod))
+			continue;
+		if (READ_ONCE(mod->state) != MODULE_STATE_LIVE) {
+			module_put(mod);
+			continue;
+		}
+		for (int i = 0; i < mod->arch.its_pages.num; i++) {
+			unsigned long start;
+
+			if (!remaining) {
+				module_put(mod);
+				goto exhausted;
+			}
+			remaining--;
+			start = (unsigned long)mod->arch.its_pages.pages[i];
+			if (!start || !IS_ALIGNED(start, PAGE_SIZE) ||
+			    start > ULONG_MAX - PAGE_SIZE ||
+			    address < start || address - start >= PAGE_SIZE)
+				continue;
+			*extent = (struct kd_generated_text_extent) {
+				.start = start, .end = start + PAGE_SIZE,
+				.owner = mod, .abi = KD_GENERATED_TEXT_ABI_VERSION,
+				.kind = KD_GENERATED_TEXT_MODULE_ITS,
+			};
+			rcu_read_unlock();
+			/* The successful reply transfers the reference to the caller. */
+			return 0;
+		}
+		module_put(mod);
+	}
+	rcu_read_unlock();
+	return -ENOENT;
+
+exhausted:
+	rcu_read_unlock();
+	return -ENOSPC;
+}
+#endif
 
