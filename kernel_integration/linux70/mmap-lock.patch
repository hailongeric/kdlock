+
+#ifdef CONFIG_KDLOCK_MMAP
+/* Transfer only an already acquired read share, before queue publication. */
+void mmap_read_unlock_prepare(struct mmap_read_token *token, struct mm_struct *mm)
+{
+	BUG_ON(!mm || READ_ONCE(token->mm));
+	mmgrab(mm);
+	WRITE_ONCE(token->mm, mm);
+}
+EXPORT_SYMBOL_GPL(mmap_read_unlock_prepare);
+
+void mmap_read_unlock_complete(struct mmap_read_token *token)
+{
+	struct mm_struct *mm = xchg(&token->mm, NULL);
+
+	/* Duplicate completion must not consume another caller's read share. */
+	BUG_ON(!mm);
+	mmap_read_unlock_non_owner(mm);
+	mmdrop_async(mm);
+}
+EXPORT_SYMBOL_GPL(mmap_read_unlock_complete);
+#endif /* CONFIG_KDLOCK_MMAP */
