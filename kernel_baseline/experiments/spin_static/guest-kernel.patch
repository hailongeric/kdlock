 EXPORT_SYMBOL(kd_raw_spin_lock);
 EXPORT_SYMBOL(kd_raw_spin_unlock);
 
+/* Updated only during controlled provider install/removal, after callers and
+ * leases have drained. This does not add a general hook-reader lifetime ABI. */
+static DEFINE_MUTEX(kd_spin_hook_update_lock);
+static DEFINE_STATIC_KEY_FALSE(kd_spin_combined_dispatch);
+
+static int kd_spin_native_select(void)
+{
+	return 0;
+}
+
+static void kd_spin_native_lock(raw_spinlock_t *lock, unsigned long rsp,
+				unsigned long rip)
+{
+	(void)rsp;
+	(void)rip;
+	__raw_spin_lock(lock);
+}
+
+static void kd_spin_native_unlock(raw_spinlock_t *lock, unsigned long rsp,
+				  unsigned long rip)
+{
+	(void)rsp;
+	(void)rip;
+	__raw_spin_unlock(lock);
+}
+
+DEFINE_STATIC_CALL(kd_spin_select, kd_spin_native_select);
+DEFINE_STATIC_CALL(kd_spin_lock_call, kd_spin_native_lock);
+DEFINE_STATIC_CALL(kd_spin_unlock_call, kd_spin_native_unlock);
+
+static int kd_spin_install(kd_spin_selector_fn select,
+			   kd_spin_callback_fn lock, kd_spin_callback_fn unlock,
+			   bool combined)
+{
+	int ret = 0;
+
+	if (!select || !lock || !unlock)
+		return -EINVAL;
+	mutex_lock(&kd_spin_hook_update_lock);
+	if (is_kd_test || kd_raw_spin_lock || kd_raw_spin_unlock) {
+		ret = -EBUSY;
+		goto out;
+	}
+	static_call_update(kd_spin_select, select);
+	static_call_update(kd_spin_lock_call, lock);
+	static_call_update(kd_spin_unlock_call, unlock);
+	if (combined)
+		static_branch_enable(&kd_spin_combined_dispatch);
+	WRITE_ONCE(kd_raw_spin_lock, lock);
+	WRITE_ONCE(kd_raw_spin_unlock, unlock);
+	/* Retain the legacy selector for the existing int3 consumer. Expose it
+	 * only after all direct call sites and callback pointers are ready. */
+	smp_wmb();
+	WRITE_ONCE(is_kd_test, select);
+out:
+	mutex_unlock(&kd_spin_hook_update_lock);
+	return ret;
+}
+
+int kd_spin_static_install(kd_spin_selector_fn select,
+			  kd_spin_callback_fn lock, kd_spin_callback_fn unlock)
+{
+	return kd_spin_install(select, lock, unlock, false);
+}
+EXPORT_SYMBOL_GPL(kd_spin_static_install);
+
+/* Combined callbacks perform their own target/retained-owner routing.
+ * Preserve the separate selector for the unchanged int3 consumer. */
+int kd_spin_static_install_dispatch(kd_spin_selector_fn select,
+			 kd_spin_callback_fn lock, kd_spin_callback_fn unlock)
+{
+	return kd_spin_install(select, lock, unlock, true);
+}
+EXPORT_SYMBOL_GPL(kd_spin_static_install_dispatch);
+
+void kd_spin_static_remove(void)
+{
+	mutex_lock(&kd_spin_hook_update_lock);
+	/* Requires the existing external no-new-callers/retired boundary. Plain
+	 * legacy selector readers are still not a generally safe hot-unload API. */
+	WRITE_ONCE(is_kd_test, NULL);
+	WRITE_ONCE(kd_raw_spin_lock, NULL);
+	WRITE_ONCE(kd_raw_spin_unlock, NULL);
+	static_branch_disable(&kd_spin_combined_dispatch);
+	static_call_update(kd_spin_select, kd_spin_native_select);
+	static_call_update(kd_spin_lock_call, kd_spin_native_lock);
+	static_call_update(kd_spin_unlock_call, kd_spin_native_unlock);
+	mutex_unlock(&kd_spin_hook_update_lock);
+}
+EXPORT_SYMBOL_GPL(kd_spin_static_remove);
+
