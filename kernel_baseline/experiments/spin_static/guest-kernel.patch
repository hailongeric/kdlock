+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _LINUX_KD_SPIN_HOOKS_H
+#define _LINUX_KD_SPIN_HOOKS_H
+
+#include <linux/spinlock_types.h>
+#define KD_SPIN_STATIC_HOOKS 1
+#define KD_SPIN_STATIC_DISPATCH 1
+
+typedef int (*kd_spin_selector_fn)(void);
+typedef void (*kd_spin_callback_fn)(raw_spinlock_t *, unsigned long, unsigned long);
+
+/* Sleepable, controlled module boundaries only; never call from a lock hook.
+ * Callers/frames must drain before removal. The existing legacy int3 selector
+ * and source pins keep their documented lifetime limitations. */
+int kd_spin_static_install(kd_spin_selector_fn select,
+			  kd_spin_callback_fn lock, kd_spin_callback_fn unlock);
+/* Opt-in combined callbacks must handle non-target tasks with native locking,
+ * retaining owner routing after comm changes or source admission closes. */
+int kd_spin_static_install_dispatch(kd_spin_selector_fn select,
+			 kd_spin_callback_fn lock, kd_spin_callback_fn unlock);
+void kd_spin_static_remove(void);
+#endif
